{
  "name": "luwan-term",
  "version": "2.0.0",
  "description": "LuwanTerm - a clean SSH client with tabbed terminals, SFTP and tunnel management.",
  "author": "LuwanIO",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run bake && electron .",
    "dev": "npm run bake && electron . --dev",
    "dist": "npm run bake && npm run make-icon && npm run make-license && npm run make-provenance && electron-builder --win --publish never",
    "pack": "npm run bake && npm run make-icon && npm run make-license && npm run make-provenance && electron-builder --dir --publish never",
    "make-icon": "node build/make-icon.js",
    "make-license": "node build/make-license-txt.js",
    "make-provenance": "node build/make-provenance.js",
    "check-copy": "node build/check-copy.js",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-cert.ps1",
    "trust-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/trust-cert.ps1",
    "dist:signed": "npm run bake && npm run make-icon && npm run make-license && npm run make-provenance && node build/dist-signed.js",
    "check": "node build/check-project.js && node test/run.js",
    "check-attacks": "node test/attacks.test.js",
    "bake": "node build/bake-config.js",
    "make-fonts": "node build/make-font-preview.js",
    "test": "node test/run.js",
    "check-site": "electron build/check-site.js",
    "make-webfonts": "node build/make-webfonts.js"
  },
  "build": {
    "appId": "io.luwan.term",
    "productName": "LuwanTerm",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "fonts/fonts.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "license": "build/license.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuwanTerm",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rathio12",
        "repo": "LuwanTerm"
      }
    ],
    "copyright": "Copyright (c) 2026 LuwanIO"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://rathio12.github.io/LuwanTerm/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rathio12/LuwanTerm.git"
  }
}

{
  "name": "luwan-term",
  "version": "1.0.0",
  "description": "LuwanTerm - a clean SSH client with tabbed terminals, SFTP and tunnel management.",
  "author": "LuwanIO",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "npm run make-icon && electron-builder --win --publish never",
    "pack": "npm run make-icon && electron-builder --dir --publish never",
    "make-icon": "node build/make-icon.js",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-cert.ps1",
    "trust-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/trust-cert.ps1",
    "dist:signed": "npm run make-icon && node build/dist-signed.js",
    "check": "node build/check-project.js"
  },
  "build": {
    "appId": "io.luwan.term",
    "productName": "LuwanTerm",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/ssh2/**/*",
      "node_modules/asn1/**/*",
      "node_modules/bcrypt-pbkdf/**/*",
      "node_modules/safer-buffer/**/*",
      "node_modules/tweetnacl/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuwanTerm",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  }
}

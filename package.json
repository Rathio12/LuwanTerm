{
  "name": "luwan-term",
  "version": "1.1.1",
  "description": "LuwanTerm - a clean SSH client with tabbed terminals, SFTP and tunnel management.",
  "author": "LuwanIO",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run bake && electron .",
    "dev": "npm run bake && electron . --dev",
    "dist": "npm run bake && npm run make-icon && electron-builder --win --publish never",
    "pack": "npm run bake && npm run make-icon && electron-builder --dir --publish never",
    "make-icon": "node build/make-icon.js",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-cert.ps1",
    "trust-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File build/trust-cert.ps1",
    "dist:signed": "npm run bake && npm run make-icon && node build/dist-signed.js",
    "check": "node build/check-project.js",
    "bake": "node build/bake-config.js"
  },
  "build": {
    "appId": "io.luwan.term",
    "productName": "LuwanTerm",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuwanTerm",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rathio12",
        "repo": "LuwanTerm"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  }
}

# Build-time configuration for LuwanTerm.
#
# Copy this to .env and adjust. Values are baked into the build by
# build/bake-config.js, so they are fixed in a release - change them here and
# rebuild rather than expecting to edit them in the app.
#
# Real environment variables override this file, so CI can set a value without
# committing it.

# Discord application to report as, from discord.com/developers/applications.
# Leave empty to disable Rich Presence entirely.
DISCORD_CLIENT_ID=1543680676539273276

# Links shown in Settings. Any left empty simply is not rendered.
LINK_GITHUB=https://github.com/Rathio12/LuwanTerm
LINK_ISSUES=https://github.com/Rathio12/LuwanTerm/issues/new
LINK_DISCORD=
